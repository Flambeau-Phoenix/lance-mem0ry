# Optional Gemini features used by some maintenance panels.
# Leave unset if you do not use those features.
# GEMINI_API_KEY=YOUR_API_KEY

# Public URL of this web panel (optional; used for self-links)
# APP_URL=http://127.0.0.1:3000

# Bind address and port of this web panel. It has no authentication, so it listens on
# loopback unless you set HOST=0.0.0.0 (or a LAN address) on a trusted network.
# HOST=127.0.0.1
# PORT=3000

# Upstream Lance Memory / FastMCP HTTP endpoint (if wired by server.ts)
# LANCE_MEMORY_HTTP_URL=http://127.0.0.1:8768/mcp