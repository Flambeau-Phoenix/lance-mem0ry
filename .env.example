# Copy to .env and fill in values. Never commit real secrets.

# Partition root for LanceDB project memories
PROJECT_MEMORIES_ROOT=/opt/lance-memory/project_memories

# Optional comma-separated authorized project IDs (omit for blank slate)
# PROJECT_MEMORY_PROJECTS=demo,example_project

# Local Ollama embeddings
OLLAMA_HOST=http://127.0.0.1:11434

# Optional LLM extraction (OpenAI-compatible). Use YOUR_API_KEY or leave unset for local-only.
# EXTRACTION_LLM_URL=http://127.0.0.1:8080/v1
# EXTRACTION_LLM_MODEL=gpt-4o-mini
# EXTRACTION_LLM_API_KEY=YOUR_API_KEY
# OPENAI_API_KEY=YOUR_API_KEY
# LANCE_MEMORY_LLM_PROVIDER=openai_compatible
# LANCE_MEMORY_LLM_BASE=http://127.0.0.1:8080/v1
# LANCE_MEMORY_LLM=gpt-4o-mini

# Deprecated fallbacks (still read if canonical vars unset):
# BUTTER_URL / BUTTER_MODEL / BUTTER_API_KEY  -> use EXTRACTION_LLM_* or LANCE_MEMORY_LLM_* instead
# ARCH_MEMORY_TRANSPORT / ARCH_MEMORY_HOST / ARCH_MEMORY_PORT / ARCH_MEMORY_*_URL
#   -> use LANCE_MEMORY_TRANSPORT / LANCE_MEMORY_HOST / LANCE_MEMORY_PORT / LANCE_MEMORY_*_URL

# HTTP / MCP service
LANCE_MEMORY_TRANSPORT=http
LANCE_MEMORY_HOST=0.0.0.0
LANCE_MEMORY_PORT=8768
LANCE_MEMORY_HTTP_URL=http://127.0.0.1:8768/mcp

# Admin UI (optional)
# EnvironmentFile example: /etc/lance-memory/admin.env
